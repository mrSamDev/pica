# Copy to .env and fill in. The stack fails fast on missing/wrong values.
# docker compose reads .env automatically; .env is gitignored.

# --- Deployment (docker-compose.yml) ---
# Required secrets are ${VAR:?} in compose, so a missing value aborts
# `docker compose up`. Platform auth needs exactly ONE path: either
# PLATFORM_TOKEN (fine-grained PAT) or the three GITHUB_APP_* variables.
POSTGRES_PASSWORD=
WEBHOOK_SECRET=
LLM_API_KEY=

# --- Platform auth (GitHub): PAT OR GitHub App -----------------------------
# GitHub App: App ID + installation ID + private key (raw PEM or base64 of the
# PEM). Install tokens are minted hourly at runtime, never a static token.
#   PLATFORM_TOKEN=
#   GITHUB_APP_ID=
#   GITHUB_INSTALLATION_ID=
#   GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY----- ... -----END RSA PRIVATE KEY-----"
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Cloudflare Tunnel token: create a tunnel in the CF dashboard (route the
# public hostname to http://app:3000), then paste its token here.
TUNNEL_TOKEN=

# --- Optional overrides ---
# PLATFORM=github            # github | bitbucket
# LLM_MODEL=deepseek/deepseek-chat-v3
# ALLOWED_HOSTS=api.github.com,github.com,api.bitbucket.org,bitbucket.org,openrouter.ai
LLM_MODEL=minimax/minimax-m3:free