# Required — no defaults. Connection strings are deployment secrets.
DATABASE_URL=postgres://user:pass@host:5432/pica
REDIS_URL=redis://host:6379

# Optional — sensible defaults shown.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Operational endpoints (dashboard + /metrics) are gated behind HTTP Basic auth.
# Required when NODE_ENV=production; empty in dev disables auth.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# Abort an LLM call that exceeds this budget (ms); a hung provider must not
# hold a review worker forever.
LLM_TIMEOUT_MS=60000
