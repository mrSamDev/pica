{
  "name": "project-pica",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:dashboard && node --env-file-if-exists=.env --watch src/server.ts",
    "build:dashboard": "vite build",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "test": "pnpm build:dashboard && vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "precommit": "pre-commit run --all-files",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "cli": "node --env-file-if-exists=.env src/cli/main.ts",
    "rebuild": "node --env-file-if-exists=.env src/cli/main.ts rebuild-read-model",
    "webhook:replay": "node --env-file-if-exists=.env tools/replay-webhook.ts"
  },
  "dependencies": {
    "bullmq": "6.3.4",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "prom-client": "^15.1.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "testcontainers": "12.1.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "4.1.11",
    "vue": "3.5.43"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0"
}
